# Postgres connection string
DATABASE_URL=postgres://postgres@localhost:5432/agcontextlink
# Public address of this server, used in links and OAuth callbacks
PUBLIC_URL=http://localhost:3000
# 32+ random bytes. Signs sessions and derives claim links.
SECRET=change-me-to-32-or-more-random-characters
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local development only: adds a one-click sign-in without OAuth
DEV_LOGIN=false

# Limits (defaults shown)
MAX_GUEST_SEATS=10
MAX_ROOM_HOURS=168
MAX_LIVE_ROOMS=10
MAX_MESSAGE_BYTES=32768
MESSAGES_PER_MINUTE=30
